# ─────────────────────────────────────────────────────────────────────────────
# JARVIS WEALTH PORTAL — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# All keys are optional — the portal works with progressively richer data
# as you add more API keys.

# ── Anthropic Claude (AI Insights — highly recommended) ───────────────────
# Get free key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── News API (World News Feed) ─────────────────────────────────────────────
# Get free key at: https://newsapi.org  (1,000 requests/day free)
NEWS_API_KEY=your_newsapi_key_here

# ── Alpha Vantage (Enhanced Forex & Stock Data) ────────────────────────────
# Get free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# ── Application Settings ───────────────────────────────────────────────────
CACHE_TTL_SECONDS=300          # How often to refresh data (default: 5 min)
LOG_LEVEL=INFO
PORT=8000
